{
  "name": "audio-sass-backend",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "migrate": "npx prisma migrate dev",
    "gen": "npx prisma generate",
    "prepare": "husky",
    "format": "prettier --write .",
    "lint-commits": "commitlint --from=HEAD~1",
    "test": "cross-env NODE_ENV=test vitest run",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "test:coverage": "cross-env NODE_ENV=test vitest run --coverage"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,json,yaml,yml,md}": "prettier --write"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.0.0",
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@openfga/sdk": "^0.9.1",
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "auth0": "^5.3.0",
    "bullmq": "^5.68.0",
    "cors": "^2.8.6",
    "dd-trace": "^6.8.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-oauth2-jwt-bearer": "^1.7.4",
    "ioredis": "^5.4.1",
    "pg": "^8.17.2",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "stripe": "^22.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.10",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.10",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "prisma": "^7.3.0",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.8",
    "hono": "^4.12.0",
    "lodash": "^4.17.23"
  }
}
